#!/bin/zsh

# Install everything: Homebrew first, then every topic's install script.
# Safe to re-run.

set -e

export DOTFILES_ROOT=${0:A:h}
source "$DOTFILES_ROOT/lib/log"

# homebrew goes first, other topics depend on it
scripts=($DOTFILES_ROOT/homebrew/install(N) $DOTFILES_ROOT/*/install(N))
typeset -U scripts

for script in $scripts; do
  info "${script:h:t}"
  zsh "$script"
  # pick up a freshly installed brew before the next topic runs
  [[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
done

success "install done, run ./sync to link config files"
