#!/bin/zsh

# Install Homebrew if missing, then everything in Brewfile.
# Brewfile.extras is optional and asked for.

set -e

source "$DOTFILES_ROOT/lib/log"

if ! command -v brew >/dev/null; then
  info "installing Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

brew bundle --file="$DOTFILES_ROOT/homebrew/Brewfile"

if read -q "?Install extras from homebrew/Brewfile.extras? (y/n) "; then
  echo
  brew bundle --file="$DOTFILES_ROOT/homebrew/Brewfile.extras"
else
  echo
  info "skipping extras"
fi
